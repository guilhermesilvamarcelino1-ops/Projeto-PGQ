# Conexão do BACKEND: use o papel app_tenant (sujeito a RLS), NUNCA o postgres.
# O papel postgres do Supabase ignora RLS e anularia o isolamento entre empresas.
DATABASE_URL=postgresql+asyncpg://app_tenant:SENHA_DO_APP_TENANT@db.<ref>.supabase.co:5432/postgres

# Conexão PRIVILEGIADA (postgres), usada só pelo onboarding/seed de empresas novas.
# Não é usada pelo backend em runtime.
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:SENHA_DO_POSTGRES@db.<ref>.supabase.co:5432/postgres

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
JWT_SECRET=troque-por-um-segredo-forte
STORAGE_DIR=./storage

# Endereço público da API — usado para montar o link que abre o procedimento
# na página citada. Em produção, o domínio real da API.
PUBLIC_BASE_URL=http://localhost:8000

# Conector OneDrive/SharePoint (Microsoft Graph).
# Obtidos no portal https://entra.microsoft.com > Registros de aplicativo.
# O CLIENT_SECRET é senha: nunca comitar, nunca colar em chat.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

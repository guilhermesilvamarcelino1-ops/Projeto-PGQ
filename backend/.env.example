# Conexão do BACKEND: use o papel app_tenant (sujeito a RLS), NUNCA o postgres.
# O papel postgres do Supabase ignora RLS e anularia o isolamento entre empresas.
DATABASE_URL=postgresql+asyncpg://app_tenant:SENHA_DO_APP_TENANT@db.<ref>.supabase.co:5432/postgres

# Conexão PRIVILEGIADA (postgres), usada só pelo onboarding/seed de empresas novas.
# Não é usada pelo backend em runtime.
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:SENHA_DO_POSTGRES@db.<ref>.supabase.co:5432/postgres

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
JWT_SECRET=troque-por-um-segredo-forte
STORAGE_DIR=./storage
